nome = input("Digite seu nome: ") #recebe um valor do usuário

#variações de imprimir texto na tela

#1° modo - usando formatadores de caracteres (igual na linguagem C) para imprimir variável e texto
print("Saudações %s, seja bem vindo ao inferno astral. Boa sorte com o Conde Drácula! " % (nome)) 

#2° modo - usando a função format() para imprimir váriavel
print("Parabéns {}, superou as dificuldades e ultrapassou o inferno astral! " .format(nome))

#3° modo - usando strings formatadas
print(f"Agora irá ganhar uma bolada {nome}, é assim que se faz! ")
