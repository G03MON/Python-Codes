texto = """ Operadores de String
Python oferece operadores para processar texto (ou seja, valores de string).
Assim como os números, as strings podem ser comparadas usando operadores de comparação:
== (Igual a), != (Diferente de), > (Maior que), >= (Maior ou igual a), < (Menor que), <= (Menor ou igual a).
O operador ==, por exemplo, retorna True se as strings nos dois lados do operador tiverem o mesmo valor.(Perkovic, p. 23, 2016)
"""

print(f"Tamanho do texto = {len(texto)}") # Conta a quantidade de caracteres na variável texto
texto = texto.lower()
texto = texto.replace(",", "").replace(".", "").replace("(", "").replace(")", "").replace("\n", " ")
lista_palavras = texto.split() # Define o valor da variável 'lista_palavras' que é o número de palavras no valor da variavel 'texto'

"""A variável 'lista_palavras' tem como valor a função split aplicada no valor da variável 'texto'
possibilitando a contagem de palavras presentes no valor da variável texto de forma individual,
onde uma palavra é considerada ."""

print(f"Tamanho de lista_palavras = {len(lista_palavras)}") # Conta a quantidade de caracteres na variável 'lista_palavras'

total = lista_palavras.count("string") + lista_palavras.count("strings")
# Atribui o valor de 'total' que é a quantidade de vezes que a palavra 'string' ou 'strings' aparecem no valor da variável 'texto'


print(f"Quantidade de vezes que string ou strings aparecem = {total}") # Exibe um o valor de 'total'
